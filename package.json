{
  "name": "duff",
  "displayName": "Duff",
  "description": "A VS Code extension",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "activationEvents": ["onCommand:duff.helloWorld"],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "duff.helloWorld",
        "title": "Hello World",
        "category": "Duff"
      }
    ]
  },
  "scripts": {
    "build": "bun build src/extension.ts --outdir dist --external vscode --format=cjs --sourcemap",
    "watch": "bun build src/extension.ts --outdir dist --external vscode --format=cjs --sourcemap --watch",
    "package": "bun x @vscode/vsce package"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0"
  }
}
