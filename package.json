{
  "name": "duff",
  "displayName": "Duff",
  "description": "Review local branch changes with native diffs and workspace files",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "activationEvents": ["onView:duff.files"],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "duff.compare",
        "title": "Compare Current Branch Against...",
        "icon": "$(git-compare)",
        "category": "Duff"
      },
      {
        "command": "duff.refresh",
        "title": "Refresh Comparison",
        "icon": "$(refresh)",
        "category": "Duff"
      },
      {
        "command": "duff.openDiff",
        "title": "Open Diff",
        "category": "Duff"
      },
      {
        "command": "duff.openFile",
        "title": "Open Workspace File",
        "icon": "$(go-to-file)",
        "category": "Duff"
      }
    ],
    "viewsContainers": {
      "activitybar": [{ "id": "duff", "title": "Duff Review", "icon": "resources/review.svg" }]
    },
    "views": {
      "duff": [{
        "id": "duff.files",
        "name": "Changed Files"
      }]
    },
    "viewsWelcome": [{
      "view": "duff.files",
      "contents": "Review committed changes on your current branch.\n[Compare Against Branch](command:duff.compare)\nClick a changed file to open its diff. Use Open Workspace File to edit and navigate."
    }],
    "menus": {
      "view/title": [
        {
          "command": "duff.compare",
          "when": "view == duff.files",
          "group": "navigation@1"
        },
        {
          "command": "duff.refresh",
          "when": "view == duff.files",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "duff.openFile",
          "when": "view == duff.files && viewItem == reviewFile",
          "group": "inline"
        },
        {
          "command": "duff.openFile",
          "when": "view == duff.files && viewItem == reviewFile",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "duff.openDiff",
          "when": "false"
        },
        {
          "command": "duff.openFile",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "build": "bun build src/extension.ts --target=node --outdir dist --external vscode --format=cjs --sourcemap=external",
    "watch": "bun build src/extension.ts --target=node --outdir dist --external vscode --format=cjs --sourcemap=external --watch",
    "check": "tsc --noEmit && eslint src",
    "test": "vitest run",
    "package": "bun x @vscode/vsce package"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.2",
    "@types/node": "26.6.4",
    "@types/vscode": "^1.85.0",
    "eslint": "10.12.0",
    "typescript": "^5.3.0",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "effect": "4.0.2"
  }
}
