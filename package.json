{
  "name": "duff-workspace",
  "private": true,
  "packageManager": "bun@1.4.0",
  "workspaces": ["packages/*"],
  "scripts": {
    "build": "bun run --cwd packages/extension build",
    "watch": "bun run --cwd packages/extension watch",
    "dev": "fish scripts/dev.fish",
    "check": "bun run --filter '*' typecheck && eslint packages",
    "test": "vitest run",
    "package": "bun run build && bun run --cwd packages/extension package"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.2",
    "@types/node": "26.6.4",
    "@types/vscode": "^1.85.0",
    "eslint": "10.12.0",
    "typescript": "^5.3.0",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}
