{
  "name": "duff-workspace",
  "private": true,
  "packageManager": "bun@1.4.0",
  "workspaces": ["packages/*"],
  "scripts": {
    "build": "bun run --cwd packages/extension build",
    "watch": "bun run --cwd packages/extension watch",
    "dev": "fish scripts/dev.fish",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --deny-warnings --fix .",
    "format": "oxfmt --write packages .vscode .oxlintrc.json .oxfmtrc.json",
    "format:check": "oxfmt --check packages .vscode .oxlintrc.json .oxfmtrc.json",
    "check": "bun run format:check && bun run typecheck && bun run lint",
    "test:app": "vitest run packages/core packages/extension",
    "test": "bun run test:app && bun run --cwd packages/anti-slop test",
    "package": "bun run build && bun run --cwd packages/extension package",
    "prepare": "effect-tsgo patch --typescript --oxlint"
  },
  "devDependencies": {
    "@effect/tsgo": "0.51.1",
    "@effect/vitest": "4.0.2",
    "@types/node": "26.6.4",
    "@types/vscode": "^1.85.0",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2003",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
