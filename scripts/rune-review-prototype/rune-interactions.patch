+fn text_pointer_hits_actual_click_and_preserves_selection() {
+    #[derive(Default)]
+    struct Hits { hovered: Option<usize>, clicks: Vec<(usize, bool)> }
+    let mut rt = Runtime::new(Hits::default(), |_: &Hits, _: &mut Cx<Hits>| {
+        text("alpha beta gamma").key("hit-text").w(250.0)
+            .font(TextStyle::new(14.0, 400.0).mono().lh(20.0)).selectable(true)
+            .on_text_pointer_move(|s: &mut Hits, byte, _, _| s.hovered = byte)
+            .on_text_press(|s: &mut Hits, byte, _, tx| {
+                if let Some(byte) = byte { s.clicks.push((byte, tx.mods().cmd)); }
+            })
+    }, (400.0, 200.0), Env::new(true, 2.0));
+    tick(&mut rt);
+    let g = glyphs(&rt, "hit-text");
+    rt.pointer_move(g[0].0, g[0].1);
+    tick(&mut rt);
+    assert_eq!(rt.state.hovered, Some(0));
+    rt.physical_input(PhysicalInput::Modifiers(Mods { cmd: true, ..Mods::default() }));
+    // No hover event at the clicked word: the click must hit its own actual point.
+    rt.pointer_down(g[5].0, g[5].1);
+    rt.pointer_up(g[5].0, g[5].1);
+    tick(&mut rt);
+    assert_eq!(rt.state.clicks, vec![(6, true)]);
+    rt.physical_input(PhysicalInput::Modifiers(Mods::default()));
+    drag(&mut rt, g[0], g[8]);
+    assert!(rt.selected_text().is_some_and(|s| !s.is_empty()));
+    assert_eq!(rt.state.clicks.len(), 1, "selection drag is not a symbol click");
+    rt.pointer_move(245.0, g[0].1);
+    tick(&mut rt);
+    assert_eq!(rt.state.hovered, None, "blank text width is not the last symbol");
