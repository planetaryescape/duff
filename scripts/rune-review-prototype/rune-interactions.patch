+//! Diff code text, display-only padding, and native source-position interactions.
+use super::*;
+use rune::{Span, rich};
+use std::ops::Range;
+
+/// A source position under the pointer, before tab padding and wrapping insertions.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct SymbolPosition {
+    pub file: usize,
+    pub side: Side,
+    /// One-based source line on `side`.
+    pub line: u32,
+    /// Zero-based UTF-8 byte column in the original source line.
+    pub byte: usize,
+    pub window_x: f32,
+    pub window_y: f32,
+}
+
+impl<S: 'static> View<S> {
+    /// Syntax colours under word changes, tabs padded to four columns.
+    pub(super) fn code(&self, st: &DiffState, f: usize, c: &Cell<'_>, copy: bool, side: Side, row_key: &str) -> El {
+        let l = &self.look;
+        let (src, n) = c.source();
+        let syntax: Vec<(Range<usize>, Color)> = st.highlights(f, src, n).into_iter().map(|(r, p)| (r, l.syntax.paint(p))).collect();
+        let word = l.tints(c.kind).map(|t| t.word);
+        let spans = layer(c.text.len(), &syntax, word.map_or(&[][..], |_| c.changes), word);
+        let (shown, spans, pads) = tabbed(c.text, spans, st.wraps());
+        let mut t = rich(shown, spans).font(l.font).color(l.text).key("text");
+        t = if st.wraps() { t.w_full() } else { t.single_line() };
+        if copy {
+            t = t.selectable(true).selection_color(l.selection);
+            t = pads.iter().cloned().fold(t, |t, r| t.uncopied(r));
+        }
+        // `Cell::source` prefers new for syntax colours. Semantic hits use the displayed side.
+        let line = if side == Side::Old { c.old } else { c.new };
+        if let Some(line) = line
+            && (self.d.on_symbol_hover.is_some() || self.d.on_symbol_press.is_some())
+        {
+            let source = Rc::new(c.text.to_owned());
+            let pads = Rc::new(pads);
+            if let Some(cb) = self.d.on_symbol_hover.clone() {
+                let leave = cb.clone();
+                let (source, pads) = (source.clone(), pads.clone());
+                t = t.on_text_pointer_move(move |s: &mut S, byte, p, tx| {
+                    let at = byte.and_then(|b| source_symbol(&source, &pads, b)).map(|byte| SymbolPosition { file: f, side, line, byte, window_x: p.window_x, window_y: p.window_y });
+                    cb(s, at, tx);
+                }).on_hover_change(move |s: &mut S, inside, tx| {
+                    if !inside { leave(s, None, tx); } else { tx.live_only(); }
+                });
+            }
+            if let Some(cb) = self.d.on_symbol_press.clone() {
+                t = t.on_text_press(move |s: &mut S, byte, p, tx| {
+                    if let Some(byte) = byte.and_then(|b| source_symbol(&source, &pads, b)) {
+                        cb(s, SymbolPosition { file: f, side, line, byte, window_x: p.window_x, window_y: p.window_y }, tx);
+                    } else { tx.live_only(); }
+                });
+            }
+        }
+        let (get, cell) = (self.d.get_mut.clone(), format!("{row_key}.{}", side as u8));
+        let mut code = col().grow(1.0).min_w(0.0).pl(CODE_PAD.0).pr(CODE_PAD.1).child(t).on_hover_change(move |s: &mut S, inside, tx: &mut Tx| {
+            if !get(s).hover_text(side, &cell, inside) { tx.live_only(); }
+        });
+        if c.no_newline {
+            code = code.child(text("No newline at end of file").font(l.small).color(l.muted).opacity(0.6).key("eof").pb(2.0));
+        }
+        code
+    }
+}
+
+/// Reverse display-only insertions; padding, punctuation and blank space aren't symbols.
+fn source_symbol(source: &str, pads: &[Range<usize>], shown: usize) -> Option<usize> {
+    if pads.iter().any(|r| r.contains(&shown)) { return None; }
+    let inserted: usize = pads.iter().filter(|r| r.end <= shown).map(|r| r.len()).sum();
+    let byte = shown.checked_sub(inserted)?;
+    let ch = source.get(byte..)?.chars().next()?;
+    (ch.is_alphanumeric() || ch == '_' || ch == '$').then_some(byte)
+}
+
+/// Tabs draw as a space followed by padding to four-column stops. Wrapped punctuation
+/// gets a zero-width space. Inserted byte ranges are never copied or sent to the backend.
+fn tabbed(code: &str, mut spans: Vec<Span>, wrap: bool) -> (String, Vec<Span>, Vec<Range<usize>>) {
+    if !code.contains('\t') && !(wrap && code.contains(['.', '(', '[', '/'])) {
+        return (code.to_owned(), spans, Vec::new());
+    }
+    let mut shown = String::with_capacity(code.len() + 8);
+    let mut shifts: Vec<(usize, usize)> = Vec::new();
+    let mut pads = Vec::new();
+    let mut col = 0;
+    let mut chars = code.char_indices().peekable();
+    while let Some((i, ch)) = chars.next() {
+        shown.push(ch);
+        col += 1;
+        let start = shown.len();
+        if ch == '\t' {
+            let pad = 3 - (col - 1) % 4;
+            shown.extend(std::iter::repeat_n(' ', pad));
+            col += pad;
+        } else if wrap && matches!(ch, '.' | '(' | '[' | '/') && chars.peek().is_some_and(|(_, c)| !c.is_whitespace()) {
+            shown.push('\u{200B}');
+        }
+        if shown.len() > start {
+            pads.push(start..shown.len());
+            shifts.push((i + ch.len_utf8(), shifts.last().map_or(0, |s| s.1) + shown.len() - start));
+        }
+    }
+    let shift = |b: u32| match shifts.partition_point(|s| s.0 <= b as usize) {
+        0 => b,
+        n => b + shifts[n - 1].1 as u32,
+    };
+    for sp in &mut spans {
+        (sp.start, sp.end) = (shift(sp.start), shift(sp.end));
+    }
+    (shown, spans, pads)
+}
+
+/// Layer syntax colours and word-change backgrounds without losing either.
+fn layer(len: usize, syntax: &[(Range<usize>, Color)], words: &[Range<usize>], bg: Option<Color>) -> Vec<Span> {
+    let mut cuts: Vec<usize> = syntax.iter().flat_map(|(r, _)| [r.start, r.end]).chain(words.iter().flat_map(|r| [r.start, r.end])).collect();
+    cuts.retain(|&c| c <= len);
+    cuts.sort_unstable();
+    cuts.dedup();
+    let mut out: Vec<Span> = Vec::new();
+    for w in cuts.windows(2) {
+        let (a, b) = (w[0], w[1]);
+        let color = syntax.get(syntax.partition_point(|(r, _)| r.end <= a)).filter(|(r, _)| r.start <= a).map(|(_, c)| *c);
+        let on = words.get(words.partition_point(|r| r.end <= a)).is_some_and(|r| r.start <= a);
+        let bg = bg.filter(|_| on);
+        if color.is_none() && bg.is_none() { continue; }
+        match out.last_mut() {
+            Some(last) if last.end as usize == a && last.color == color && last.bg == bg => last.end = b as u32,
+            _ => {
+                let mut sp = Span::new(a, b);
+                sp.color = color;
+                sp.bg = bg;
+                out.push(sp);
+            }
+        }
+    }
+    out
+}
+
