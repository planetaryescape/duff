{
  "name": "@duff/terminal",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun run src/main.tsx",
    "typecheck": "tsc --noEmit",
    "build": "bun build src/main.tsx --target=bun --packages=external --outdir=dist"
  },
  "dependencies": {
    "@duff/core": "workspace:*",
    "@opentui/core": "0.5.6",
    "@opentui/react": "0.5.6",
    "effect": "4.0.5",
    "neovim": "5.4.0",
    "react": "19.2.4",
    "shell-quote": "1.8.3",
    "winston": "3.15.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "@types/react": "^19.2.14",
    "@types/shell-quote": "1.7.5"
  }
}
