{
  "name": "duff",
  "private": true,
  "displayName": "Duff",
  "description": "Review local branch changes with native diffs and workspace files",
  "version": "0.3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/planetaryescape/duff.git",
    "directory": "packages/extension"
  },
  "engines": {
    "vscode": "^1.123.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onFileSystem:duff-draft",
    "onWebviewPanel:duff.dashboard",
    "onView:duff.files"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "duff.toggleComments",
        "title": "Hide / Show PR Comments",
        "icon": "$(comment-discussion)",
        "category": "Duff"
      },
      {
        "command": "duff.refreshComments",
        "title": "Refresh Comments",
        "icon": "$(refresh)",
        "category": "Duff"
      },
      {
        "command": "duff.loadMoreDiscussion",
        "title": "Load More Saved Discussion",
        "category": "Duff",
        "enablement": "duff.discussionHasMore"
      },
      {
        "command": "duff.startDiscussionThread",
        "title": "Start Thread in Draft Editor",
        "category": "Duff"
      },
      {
        "command": "duff.replyDiscussionThread",
        "title": "Reply in Draft Editor",
        "icon": "$(reply)",
        "category": "Duff"
      },
      {
        "command": "duff.resolveDiscussionThread",
        "title": "Resolve Thread",
        "icon": "$(check)",
        "category": "Duff"
      },
      {
        "command": "duff.reopenDiscussionThread",
        "title": "Reopen Thread",
        "icon": "$(discard)",
        "category": "Duff"
      },
      {
        "command": "duff.openDiscussionDraft",
        "title": "Open Saved Draft",
        "category": "Duff"
      },
      {
        "command": "duff.sendDiscussionDraft",
        "title": "Send Draft…",
        "icon": "$(send)",
        "category": "Duff",
        "enablement": "duff.draftReady"
      },
      {
        "command": "duff.discardDiscussionDraft",
        "title": "Discard Draft…",
        "icon": "$(trash)",
        "category": "Duff"
      },
      {
        "command": "duff.copyDiscussionDraft",
        "title": "Copy Draft for Recovery",
        "icon": "$(copy)",
        "category": "Duff"
      },
      {
        "command": "duff.returnToDiscussionDiff",
        "title": "Return to Draft's Diff",
        "icon": "$(git-compare)",
        "category": "Duff"
      },
      {
        "command": "duff.inspectDiscussionThread",
        "title": "Read Unplaced Thread",
        "category": "Duff"
      },
      {
        "command": "duff.inspectDiscussionAttempt",
        "title": "Inspect Saved Send Attempt",
        "category": "Duff"
      },
      {
        "command": "duff.dashboard",
        "title": "Open Pull Request Dashboard",
        "icon": "$(home)",
        "category": "Duff"
      },
      {
        "command": "duff.renameRepository",
        "title": "Rename…",
        "category": "Duff"
      },
      {
        "command": "duff.compare",
        "title": "Compare Current Branch Against...",
        "icon": "$(git-compare)",
        "category": "Duff"
      },
      {
        "command": "duff.refresh",
        "title": "Refresh Comparison",
        "icon": "$(refresh)",
        "category": "Duff"
      },
      {
        "command": "duff.toggleLayout",
        "title": "Toggle File List / Tree",
        "icon": "$(list-tree)",
        "category": "Duff"
      },
      {
        "command": "duff.inspectContext",
        "title": "Show Git Diagnostics",
        "icon": "$(refresh)",
        "category": "Duff"
      },
      {
        "command": "duff.openDiff",
        "title": "Open Diff",
        "category": "Duff"
      },
      {
        "command": "duff.refreshProviders",
        "title": "Check Pull Requests",
        "icon": "$(refresh)",
        "category": "Duff"
      },
      {
        "command": "duff.searchPullRequests",
        "title": "Search Pull Requests…",
        "icon": "$(search)",
        "category": "Duff"
      },
      {
        "command": "duff.filterPullRequests",
        "title": "Show Open / Merged / Closed Pull Requests…",
        "icon": "$(filter)",
        "category": "Duff"
      },
      {
        "command": "duff.reviewPullRequest",
        "title": "Review Pull Request Locally",
        "category": "Duff"
      },
      {
        "command": "duff.openPullRequestBrowser",
        "title": "Open Pull Request in Browser",
        "icon": "$(link-external)",
        "category": "Duff"
      },
      {
        "command": "duff.fetchReviewRevisions",
        "title": "Fetch PR Revisions…",
        "icon": "$(cloud-download)",
        "category": "Duff"
      },
      {
        "command": "duff.cancelPullRequestReview",
        "title": "Cancel PR Preparation",
        "icon": "$(close)",
        "category": "Duff"
      },
      {
        "command": "duff.refreshPullRequestReview",
        "title": "Refresh PR Review",
        "icon": "$(refresh)",
        "category": "Duff"
      },
      {
        "command": "duff.exitPullRequestReview",
        "title": "Exit PR Review",
        "icon": "$(sign-out)",
        "category": "Duff"
      },
      {
        "command": "duff.resumeReview",
        "title": "Resume Review…",
        "icon": "$(history)",
        "category": "Duff"
      },
      {
        "command": "duff.forgetReview",
        "title": "Forget Saved Review…",
        "category": "Duff"
      },
      {
        "command": "duff.loadMoreProviders",
        "title": "Load More Pull Requests",
        "category": "Duff"
      },
      {
        "command": "duff.connectProvider",
        "title": "Connect Provider",
        "category": "Duff"
      },
      {
        "command": "duff.openSelectedFile",
        "title": "Open Selected Workspace File",
        "category": "Duff"
      },
      {
        "command": "duff.openFile",
        "title": "Open Workspace File",
        "icon": "$(go-to-file)",
        "category": "Duff"
      },
      {
        "command": "duff.markViewed",
        "title": "Mark as Viewed",
        "icon": "$(check)",
        "category": "Duff"
      },
      {
        "command": "duff.markUnviewed",
        "title": "Mark as Unviewed",
        "icon": "$(discard)",
        "category": "Duff"
      }
    ],
    "keybindings": [
      {
        "command": "duff.openSelectedFile",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "focusedView == duff.files && listFocus"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "duff",
          "title": "Duff Review",
          "icon": "resources/review.svg"
        }
      ]
    },
    "views": {
      "duff": [
        {
          "id": "duff.discussion",
          "name": "PR Discussion"
        },
        {
          "id": "duff.files",
          "name": "Changed Files"
        },
        {
          "id": "duff.context",
          "name": "Git Diagnostics",
          "when": "duff.gitDiagnostics"
        },
        {
          "id": "duff.providers",
          "name": "Pull Requests"
        }
      ]
    },
    "configuration": {
      "title": "Duff",
      "properties": {
        "duff.automaticDiscovery": {
          "type": "boolean",
          "default": true,
          "description": "Read open pull requests automatically after local Git inspection. Never prompts for sign-in or changes Git. When disabled, use Check Pull Requests for a manual read."
        },
        "duff.telemetry": {
          "type": "string",
          "enum": [
            "off",
            "local"
          ],
          "enumDescriptions": [
            "Export nothing.",
            "Export operation spans and outcome logs to a local OpenTelemetry stack: Tempo on 127.0.0.1:14318 and Alloy on 127.0.0.1:14320."
          ],
          "default": "off",
          "scope": "application",
          "markdownDescription": "Opt in to local operation telemetry. Spans carry only operation names and status; logs carry only operation, outcome, and error type. Nothing leaves this machine. Reload the window to apply."
        }
      }
    },
    "viewsWelcome": [
      {
        "view": "duff.files",
        "contents": "[Open Pull Request Dashboard](command:duff.dashboard)\nReview committed changes on your current branch.\n[Compare Against Branch](command:duff.compare)\n[Resume Review…](command:duff.resumeReview)\nClick a changed file to open its diff. Use Open Workspace File to edit and navigate."
      },
      {
        "view": "duff.context",
        "contents": "Inspect local identity and credential configuration without authenticating.\n[Show Git Diagnostics](command:duff.inspectContext)"
      },
      {
        "view": "duff.providers",
        "contents": "Review pull requests from GitHub and Azure DevOps.\n[Check Pull Requests](command:duff.refreshProviders)\n[Show Open / Merged / Closed…](command:duff.filterPullRequests)",
        "when": "config.duff.automaticDiscovery != false"
      },
      {
        "view": "duff.providers",
        "contents": "Automatic discovery is off. Check pull requests when you need them, without enabling background discovery.\n[Check Pull Requests](command:duff.refreshProviders)",
        "when": "config.duff.automaticDiscovery == false"
      }
    ],
    "menus": {
      "webview/context": [
        {
          "command": "duff.renameRepository",
          "when": "webviewId == 'duff.dashboard' && webviewSection == 'repository'"
        }
      ],
      "view/title": [
        {
          "command": "duff.refreshComments",
          "when": "view == duff.discussion",
          "group": "navigation@1"
        },
        {
          "command": "duff.loadMoreDiscussion",
          "when": "view == duff.discussion",
          "group": "discussion@1"
        },
        {
          "command": "duff.dashboard",
          "when": "view == duff.files || view == duff.providers",
          "group": "navigation@0"
        },
        {
          "command": "duff.compare",
          "when": "view == duff.files",
          "group": "navigation@1"
        },
        {
          "command": "duff.refresh",
          "when": "view == duff.files && !duff.prReview && duff.prPreparation != Preparing && duff.prPreparation != AwaitingFetch",
          "group": "navigation@2"
        },
        {
          "command": "duff.refreshPullRequestReview",
          "when": "view == duff.files && duff.prReview && duff.prPreparation != Preparing && duff.prPreparation != AwaitingFetch",
          "group": "navigation@2"
        },
        {
          "command": "duff.exitPullRequestReview",
          "when": "view == duff.files && duff.prReview",
          "group": "navigation@5"
        },
        {
          "command": "duff.resumeReview",
          "when": "view == duff.files",
          "group": "navigation@4"
        },
        {
          "command": "duff.forgetReview",
          "when": "view == duff.files",
          "group": "review@1"
        },
        {
          "command": "duff.fetchReviewRevisions",
          "when": "view == duff.files && duff.prPreparation == AwaitingFetch",
          "group": "navigation@2"
        },
        {
          "command": "duff.cancelPullRequestReview",
          "when": "view == duff.files && (duff.prPreparation == AwaitingFetch || duff.prPreparation == Preparing)",
          "group": "navigation@4"
        },
        {
          "command": "duff.toggleLayout",
          "when": "view == duff.files",
          "group": "navigation@3"
        },
        {
          "command": "duff.inspectContext",
          "when": "view == duff.context",
          "group": "navigation@1"
        },
        {
          "command": "duff.searchPullRequests",
          "when": "view == duff.providers",
          "group": "navigation@1"
        },
        {
          "command": "duff.filterPullRequests",
          "when": "view == duff.providers",
          "group": "navigation@2"
        },
        {
          "command": "duff.refreshProviders",
          "when": "view == duff.providers",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "duff.openPullRequestBrowser",
          "when": "view == duff.providers && viewItem == pullRequest",
          "group": "inline@1"
        },
        {
          "command": "duff.openPullRequestBrowser",
          "when": "view == duff.providers && viewItem == pullRequest",
          "group": "navigation@1"
        },
        {
          "command": "duff.markViewed",
          "when": "view == duff.files && viewItem =~ /^(deletedReviewFile|reviewFile|reviewFolder)\\.unviewed$/",
          "group": "navigation@1"
        },
        {
          "command": "duff.markUnviewed",
          "when": "view == duff.files && viewItem =~ /^(deletedReviewFile|reviewFile|reviewFolder)\\.viewed$/",
          "group": "navigation@1"
        },
        {
          "command": "duff.openFile",
          "when": "view == duff.files && viewItem =~ /^reviewFile\\./",
          "group": "inline@2"
        },
        {
          "command": "duff.openFile",
          "when": "view == duff.files && viewItem =~ /^reviewFile\\./",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "duff.toggleComments",
          "when": "duff.commentableSnapshot"
        },
        {
          "command": "duff.refreshComments",
          "when": "duff.prReview"
        },
        {
          "command": "duff.startDiscussionThread",
          "when": "resourceScheme == duff-snapshot && duff.commentableSnapshot"
        },
        {
          "command": "duff.sendDiscussionDraft",
          "when": "resourceScheme == duff-draft"
        },
        {
          "command": "duff.discardDiscussionDraft",
          "when": "resourceScheme == duff-draft"
        },
        {
          "command": "duff.copyDiscussionDraft",
          "when": "resourceScheme == duff-draft"
        },
        {
          "command": "duff.returnToDiscussionDiff",
          "when": "resourceScheme == duff-draft"
        },
        {
          "command": "duff.replyDiscussionThread",
          "when": "false"
        },
        {
          "command": "duff.resolveDiscussionThread",
          "when": "false"
        },
        {
          "command": "duff.reopenDiscussionThread",
          "when": "false"
        },
        {
          "command": "duff.openDiscussionDraft",
          "when": "false"
        },
        {
          "command": "duff.inspectDiscussionThread",
          "when": "false"
        },
        {
          "command": "duff.inspectDiscussionAttempt",
          "when": "false"
        },
        {
          "command": "duff.loadMoreDiscussion",
          "when": "true"
        },
        {
          "command": "duff.renameRepository",
          "when": "false"
        },
        {
          "command": "duff.openSelectedFile",
          "when": "false"
        },
        {
          "command": "duff.reviewPullRequest",
          "when": "false"
        },
        {
          "command": "duff.openPullRequestBrowser",
          "when": "false"
        },
        {
          "command": "duff.refreshPullRequestReview",
          "when": "duff.prReview && duff.prPreparation != Preparing && duff.prPreparation != AwaitingFetch"
        },
        {
          "command": "duff.exitPullRequestReview",
          "when": "duff.prReview"
        },
        {
          "command": "duff.fetchReviewRevisions",
          "when": "duff.prPreparation == AwaitingFetch"
        },
        {
          "command": "duff.cancelPullRequestReview",
          "when": "duff.prPreparation == Preparing || duff.prPreparation == AwaitingFetch"
        },
        {
          "command": "duff.refresh",
          "when": "!duff.prReview && duff.prPreparation != Preparing && duff.prPreparation != AwaitingFetch"
        },
        {
          "command": "duff.markViewed",
          "when": "duff.activeFileState == unviewed"
        },
        {
          "command": "duff.markUnviewed",
          "when": "duff.activeFileState == viewed"
        },
        {
          "command": "duff.loadMoreProviders",
          "when": "false"
        },
        {
          "command": "duff.connectProvider",
          "when": "false"
        },
        {
          "command": "duff.openDiff",
          "when": "false"
        },
        {
          "command": "duff.openFile",
          "when": "resourceScheme == duff-snapshot"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "duff.replyDiscussionThread",
          "when": "commentController == duff.discussion && commentThread =~ /^duff\\.thread\\.reply\\./",
          "group": "navigation@1"
        },
        {
          "command": "duff.resolveDiscussionThread",
          "when": "commentController == duff.discussion && commentThread =~ /resolve$/",
          "group": "navigation@2"
        },
        {
          "command": "duff.reopenDiscussionThread",
          "when": "commentController == duff.discussion && commentThread =~ /reopen$/",
          "group": "navigation@2"
        }
      ],
      "editor/context": [
        {
          "command": "duff.startDiscussionThread",
          "when": "resourceScheme == duff-snapshot && duff.commentableSnapshot",
          "group": "duff@1"
        }
      ],
      "editor/title": [
        {
          "command": "duff.toggleComments",
          "when": "resourceScheme == duff-snapshot && duff.commentableSnapshot",
          "group": "navigation@3"
        },
        {
          "command": "duff.sendDiscussionDraft",
          "when": "resourceScheme == duff-draft",
          "group": "navigation@1"
        },
        {
          "command": "duff.discardDiscussionDraft",
          "when": "resourceScheme == duff-draft",
          "group": "navigation@2"
        },
        {
          "command": "duff.copyDiscussionDraft",
          "when": "resourceScheme == duff-draft",
          "group": "draft@1"
        },
        {
          "command": "duff.returnToDiscussionDiff",
          "when": "resourceScheme == duff-draft",
          "group": "navigation@3"
        },
        {
          "command": "duff.markViewed",
          "when": "resourceScheme == duff-snapshot && duff.activeFileState == unviewed",
          "group": "navigation@2"
        },
        {
          "command": "duff.markUnviewed",
          "when": "resourceScheme == duff-snapshot && duff.activeFileState == viewed",
          "group": "navigation@2"
        },
        {
          "command": "duff.openFile",
          "when": "resourceScheme == duff-snapshot",
          "group": "navigation@1"
        }
      ]
    }
  },
  "scripts": {
    "build": "bun build src/extension.ts --target=node --outdir dist --external vscode --format=cjs --sourcemap=external --define 'import.meta={}' --define 'import.meta.url=__filename'",
    "watch": "bun build src/extension.ts --target=node --outdir dist --external vscode --format=cjs --sourcemap=external --define 'import.meta={}' --define 'import.meta.url=__filename' --watch",
    "typecheck": "tsc --noEmit",
    "package": "bun x @vscode/vsce@4.0.0 package --no-dependencies --allow-missing-repository --skip-license"
  },
  "dependencies": {
    "@duff/core": "workspace:*",
    "effect": "4.0.5",
    "markdown-it": "^15.0.3"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0"
  }
}
