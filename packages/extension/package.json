{
  "name": "duff",
  "private": true,
  "displayName": "Duff",
  "description": "Review local branch changes with native diffs and workspace files",
  "version": "0.0.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/planetaryescape/duff.git",
    "directory": "packages/extension"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "activationEvents": ["onView:duff.files"],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "duff.compare",
        "title": "Compare Current Branch Against...",
        "icon": "$(git-compare)",
        "category": "Duff"
      },
      {
        "command": "duff.refresh",
        "title": "Refresh Comparison",
        "icon": "$(refresh)",
        "category": "Duff"
      },
      {
        "command": "duff.toggleLayout",
        "title": "Toggle File List / Tree",
        "icon": "$(list-tree)",
        "category": "Duff"
      },
      {
        "command": "duff.inspectContext",
        "title": "Inspect / Refresh Git Context",
        "icon": "$(refresh)",
        "category": "Duff"
      },
      {
        "command": "duff.openDiff",
        "title": "Open Diff",
        "category": "Duff"
      },
      {
        "command": "duff.refreshProviders",
        "title": "Check Pull Requests",
        "icon": "$(refresh)",
        "category": "Duff"
      },
      {
        "command": "duff.loadMoreProviders",
        "title": "Load More Pull Requests",
        "category": "Duff"
      },
      {
        "command": "duff.connectProvider",
        "title": "Connect Provider",
        "category": "Duff"
      },
      {
        "command": "duff.openFile",
        "title": "Open Workspace File",
        "icon": "$(go-to-file)",
        "category": "Duff"
      },
      {
        "command": "duff.markViewed",
        "title": "Mark as Viewed",
        "icon": "$(check)",
        "category": "Duff"
      },
      {
        "command": "duff.markUnviewed",
        "title": "Mark as Unviewed",
        "icon": "$(discard)",
        "category": "Duff"
      }
    ],
    "viewsContainers": {
      "activitybar": [{ "id": "duff", "title": "Duff Review", "icon": "resources/review.svg" }]
    },
    "views": {
      "duff": [{
        "id": "duff.files",
        "name": "Changed Files"
      }, {
        "id": "duff.context",
        "name": "Git Context"
      }, {
        "id": "duff.providers",
        "name": "Pull Requests"
      }]
    },
    "configuration": {
      "title": "Duff",
      "properties": {
        "duff.automaticDiscovery": {
          "type": "boolean",
          "default": true,
          "description": "Read open pull requests automatically after local Git inspection. Never prompts for sign-in or changes Git. When disabled, use Check Pull Requests for a manual read."
        }
      }
    },
    "viewsWelcome": [{
      "view": "duff.files",
      "contents": "Review committed changes on your current branch.\n[Compare Against Branch](command:duff.compare)\nClick a changed file to open its diff. Use Open Workspace File to edit and navigate."
    }, {
      "view": "duff.context",
      "contents": "Inspect local identity and credential configuration without authenticating.\n[Inspect Git Context](command:duff.inspectContext)"
    }, {
      "view": "duff.providers",
      "contents": "Discover open pull requests for GitHub and Azure DevOps remotes.\n[Check Pull Requests](command:duff.refreshProviders)",
      "when": "config.duff.automaticDiscovery != false"
    }, {
      "view": "duff.providers",
      "contents": "Automatic discovery is off. Check pull requests when you need them, without enabling background discovery.\n[Check Pull Requests](command:duff.refreshProviders)",
      "when": "config.duff.automaticDiscovery == false"
    }],
    "menus": {
      "view/title": [
        {
          "command": "duff.compare",
          "when": "view == duff.files",
          "group": "navigation@1"
        },
        {
          "command": "duff.refresh",
          "when": "view == duff.files",
          "group": "navigation@2"
        },
        {
          "command": "duff.toggleLayout",
          "when": "view == duff.files",
          "group": "navigation@3"
        },
        {
          "command": "duff.inspectContext",
          "when": "view == duff.context",
          "group": "navigation@1"
        },
        {
          "command": "duff.refreshProviders",
          "when": "view == duff.providers",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "duff.markViewed",
          "when": "view == duff.files && viewItem =~ /^(deletedReviewFile|reviewFile)\\.unviewed$/",
          "group": "inline@1"
        },
        {
          "command": "duff.markUnviewed",
          "when": "view == duff.files && viewItem =~ /^(deletedReviewFile|reviewFile)\\.viewed$/",
          "group": "inline@1"
        },
        {
          "command": "duff.markViewed",
          "when": "view == duff.files && viewItem =~ /^(deletedReviewFile|reviewFile)\\.unviewed$/",
          "group": "navigation@1"
        },
        {
          "command": "duff.markUnviewed",
          "when": "view == duff.files && viewItem =~ /^(deletedReviewFile|reviewFile)\\.viewed$/",
          "group": "navigation@1"
        },
        {
          "command": "duff.openFile",
          "when": "view == duff.files && viewItem =~ /^reviewFile\\./",
          "group": "inline@2"
        },
        {
          "command": "duff.openFile",
          "when": "view == duff.files && viewItem =~ /^reviewFile\\./",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "duff.markViewed",
          "when": "duff.activeFileState == unviewed"
        },
        {
          "command": "duff.markUnviewed",
          "when": "duff.activeFileState == viewed"
        },
        {
          "command": "duff.loadMoreProviders",
          "when": "false"
        },
        {
          "command": "duff.connectProvider",
          "when": "false"
        },
        {
          "command": "duff.openDiff",
          "when": "false"
        },
        {
          "command": "duff.openFile",
          "when": "resourceScheme == duff-snapshot"
        }
      ],
      "editor/title": [
        {
          "command": "duff.markViewed",
          "when": "resourceScheme == duff-snapshot && duff.activeFileState == unviewed",
          "group": "navigation@2"
        },
        {
          "command": "duff.markUnviewed",
          "when": "resourceScheme == duff-snapshot && duff.activeFileState == viewed",
          "group": "navigation@2"
        },
        {
          "command": "duff.openFile",
          "when": "resourceScheme == duff-snapshot",
          "group": "navigation@1"
        }
      ]
    }
  },
  "scripts": {
    "build": "bun build src/extension.ts --target=node --outdir dist --external vscode --format=cjs --sourcemap=external --define 'import.meta={}' --define 'import.meta.url=__filename'",
    "watch": "bun build src/extension.ts --target=node --outdir dist --external vscode --format=cjs --sourcemap=external --define 'import.meta={}' --define 'import.meta.url=__filename' --watch",
    "typecheck": "tsc --noEmit",
    "package": "bun x @vscode/vsce@4.0.0 package --no-dependencies --allow-missing-repository --skip-license"
  },
  "dependencies": {
    "@duff/core": "workspace:*",
    "effect": "4.0.2"
  }
}
