{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": true,
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "trailingComma": "all",
  "arrowParens": "always",
  "bracketSpacing": true,
  "endOfLine": "lf",
  "sortImports": {
    "groups": ["builtin", "external", "internal", ["parent", "sibling", "index"]],
    "newlinesBetween": true
  },
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/package.json",
    "**/tsconfig*.json",
    "packages/anti-slop/**",
    ".amp/**",
    "bun.lock"
  ]
}
